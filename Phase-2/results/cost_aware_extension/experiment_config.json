{
    "dataset": "Wine",
    "openml_id": 44091,
    "task_type": "binary_classification",
    "n_classes": 2,
    "replicate_seeds": [
        0,
        1,
        2
    ],
    "matched_q_targets": [
        0.2,
        0.4,
        0.6,
        0.8
    ],
    "cost_lambdas": [
        0.0,
        0.1,
        1.0
    ],
    "cost_gb": 1.0,
    "cost_bb": 10.0,
    "timing_repetitions": 30,
    "component_models": {
        "glass_box": {
            "model": "LogisticRegression",
            "params": {
